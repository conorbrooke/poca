generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BankProvider {
  ENABLE_BANKING
  GOCARDLESS
  CSV
  MANUAL
}

enum BankConnectionStatus {
  PENDING
  LINKED
  EXPIRED
  ERROR
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CategoryKind {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransferLinkStatus {
  SUGGESTED
  CONFIRMED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  bankConnections  BankConnection[]
  categories       Category[]
  categoryRules    CategoryRule[]
  categoryPeriodStats CategoryPeriodStat[]
  tags             Tag[]
  syncJobs         SyncJob[]
  accountTransfers AccountTransfer[]

  @@index([email])
}

model BankConnection {
  id              String               @id @default(cuid())
  userId          String
  provider        BankProvider         @default(ENABLE_BANKING)
  institutionId   String
  institutionName String
  requisitionId   String?              @unique
  status          BankConnectionStatus @default(PENDING)
  consentExpiresAt DateTime?
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]
  stats    ConnectionStats?

  @@index([userId])
  @@index([requisitionId])
  @@index([status])
}

model ConnectionStats {
  id                 String   @id @default(cuid())
  bankConnectionId   String   @unique
  totalIncome        Decimal  @default(0) @db.Decimal(14, 2)
  totalSpent         Decimal  @default(0) @db.Decimal(14, 2)
  netFlow            Decimal  @default(0) @db.Decimal(14, 2)
  transactionCount   Int      @default(0)
  avgTransactionSize Decimal  @default(0) @db.Decimal(14, 2)
  thisMonthIncome    Decimal  @default(0) @db.Decimal(14, 2)
  thisMonthSpent     Decimal  @default(0) @db.Decimal(14, 2)
  computedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@index([bankConnectionId])
}

model Account {
  id               String       @id @default(cuid())
  userId           String
  bankConnectionId String?
  externalId       String?
  name             String
  iban             String?
  currency         String       @default("EUR")
  accountType      String?
  product          String?
  provider         BankProvider @default(MANUAL)
  currentBalance   Decimal      @default(0) @db.Decimal(14, 2)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnection BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@unique([userId, externalId])
  @@index([userId])
  @@index([bankConnectionId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  color     String       @default("#6366f1")
  icon      String?
  kind      CategoryKind @default(EXPENSE)
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  splits       TransactionSplit[]
  rules        CategoryRule[]
  periodStats  CategoryPeriodStat[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, deletedAt])
}

model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  matchText  String
  payeeLabel String
  priority   Int      @default(0)
  source     String   @default("user")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags     CategoryRuleTag[]

  @@index([userId])
  @@index([categoryId])
  @@index([userId, priority])
}

model CategoryPeriodStat {
  id               String   @id @default(cuid())
  userId           String
  categoryId       String
  bankConnectionId String?
  rangeType        String
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  totalSpent       Decimal  @default(0) @db.Decimal(14, 2)
  transactionCount Int      @default(0)
  computedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payees   PayeePeriodStat[]

  @@unique([userId, categoryId, bankConnectionId, rangeType, periodStart])
  @@index([userId, rangeType, periodStart])
  @@index([categoryId])
}

model PayeePeriodStat {
  id                   String   @id @default(cuid())
  categoryPeriodStatId String
  payeeLabel           String
  totalSpent           Decimal  @default(0) @db.Decimal(14, 2)
  transactionCount     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categoryPeriodStat CategoryPeriodStat @relation(fields: [categoryPeriodStatId], references: [id], onDelete: Cascade)

  @@unique([categoryPeriodStatId, payeeLabel])
  @@index([categoryPeriodStatId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  splits       TransactionSplitTag[]
  rules        CategoryRuleTag[]

  @@unique([userId, name])
  @@index([userId])
}

model CategoryRuleTag {
  ruleId String
  tagId  String

  rule CategoryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tag  Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
  @@index([tagId])
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  categoryId  String?
  externalId  String?
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("EUR")
  description String
  merchant    String?
  payeeLabel  String?
  bookedAt    DateTime
  isSplit     Boolean  @default(false)
  categoryLocked Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     TransactionTag[]
  splits              TransactionSplit[]
  receipts            TransactionReceipt[]
  transferOut         AccountTransfer? @relation("TransferOut")
  transferIn          AccountTransfer? @relation("TransferIn")

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([categoryId])
  @@index([bookedAt])
  @@index([payeeLabel])
  @@index([isSplit])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model TransactionSplit {
  id            String   @id @default(cuid())
  transactionId String
  categoryId    String
  amount        Decimal  @db.Decimal(14, 2)
  payeeLabel    String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags        TransactionSplitTag[]

  @@index([transactionId])
  @@index([categoryId])
}

model TransactionSplitTag {
  splitId String
  tagId   String

  split TransactionSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  tag   Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([splitId, tagId])
  @@index([tagId])
}

model TransactionReceipt {
  id            String   @id @default(cuid())
  transactionId String
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model AccountTransfer {
  id               String             @id @default(cuid())
  userId           String
  outTransactionId String             @unique
  inTransactionId  String?            @unique
  status           TransferLinkStatus @default(SUGGESTED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outTransaction Transaction  @relation("TransferOut", fields: [outTransactionId], references: [id], onDelete: Cascade)
  inTransaction  Transaction? @relation("TransferIn", fields: [inTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SyncJob {
  id               String        @id @default(cuid())
  userId           String
  bankConnectionId String?
  status           SyncJobStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
