# Database
DATABASE_URL="postgresql://poca:poca@localhost:5432/poca?schema=public"

# Redis (for future background jobs)
REDIS_URL="redis://localhost:6379"

# Enable Banking (https://enablebanking.com)
# 1. Register a Production app in the Control Panel → API applications
# 2. Save the downloaded .pem file (filename = application ID)
# 3. Whitelist the web callback in Enable Banking (API applications → Redirect URIs).
#    Production apps reject http://localhost — use the Vercel URL:
#    https://YOUR-APP.vercel.app/bank/callback
# 4. Activate via "Activate by linking accounts" for personal use
ENABLE_BANKING_APPLICATION_ID=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Must match an Enable Banking whitelisted redirect URI exactly.
BANK_REDIRECT_URL="https://YOUR-APP.vercel.app/bank/callback"
# Optional: paste PEM directly instead of path
# ENABLE_BANKING_PRIVATE_KEY=""

# API (local Nest). When the web app is on Vercel, expose this with `ngrok http 3001`.
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="https://YOUR-APP.vercel.app"
CORS_ORIGINS="http://localhost:3000,https://YOUR-APP.vercel.app"

# Local `pnpm dev` — browser talks directly to Nest
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_BANK_REDIRECT_URL="https://YOUR-APP.vercel.app/bank/callback"

# Vercel project env (not this file):
#   NEXT_PUBLIC_API_URL="/api/backend"
#   API_URL="https://YOUR-SUBDOMAIN.ngrok-free.dev"   # tunnel to local :3001
#   ACCESS_CODE="..."
#   NEXT_PUBLIC_BANK_REDIRECT_URL="https://YOUR-APP.vercel.app/bank/callback"

# App
NODE_ENV="development"

# Web access gate (temporary until real auth)
ACCESS_CODE="110811"

# Receipt uploads — saved on the machine running the API (defaults to ~/Desktop/Póca Receipts)
# RECEIPTS_DIR="~/Desktop/Póca Receipts"
