# Database
DATABASE_URL="postgresql://poca:poca@localhost:5432/poca?schema=public"

# Redis (for future background jobs)
REDIS_URL="redis://localhost:6379"

# Enable Banking (https://enablebanking.com)
# 1. Register a Production app in the Control Panel → API applications
# 2. Save the downloaded .pem file (filename = application ID)
# 3. Whitelist the same URL in Enable Banking (API applications → Redirect URIs):
#    http://localhost:3000/bank/callback
# 4. Activate via "Activate by linking accounts" for personal use
ENABLE_BANKING_APPLICATION_ID=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Must match an Enable Banking whitelisted redirect URI exactly (HTTPS in production).
# Local dev: run `ngrok http 3000` (web app — not the API port) and use that URL.
BANK_REDIRECT_URL="https://YOUR-SUBDOMAIN.ngrok-free.dev/bank/callback"
# Optional: paste PEM directly instead of path
# ENABLE_BANKING_PRIVATE_KEY=""

# API
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL=""
CORS_ORIGINS="http://localhost:3000"

# Web (local dev — browser talks directly to local API)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_BANK_REDIRECT_URL="https://YOUR-SUBDOMAIN.ngrok-free.dev/bank/callback"

# Vercel + ngrok (browser → Vercel proxy → ngrok → local API)
# NEXT_PUBLIC_API_URL="/api/backend"
# API_URL="https://YOUR-SUBDOMAIN.ngrok-free.dev"

# App
NODE_ENV="development"

# Web access gate (temporary until real auth)
ACCESS_CODE="110811"

# Receipt uploads — saved on the machine running the API (defaults to ~/Desktop/Póca Receipts)
# RECEIPTS_DIR="~/Desktop/Póca Receipts"
