{
  "name": "poca",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @poca/db generate",
    "db:migrate": "pnpm --filter @poca/db migrate:dev",
    "db:studio": "pnpm --filter @poca/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
